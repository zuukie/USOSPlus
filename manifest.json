{
  "manifest_version": 3,
  "name": "USOS++ (Beta)",
  "version": "0.9.3",
  "description": "Nowoczesna wersja systemu USOSweb: oceny, plan zajęć, płatności i egzaminy w jednym, szybkim panelu — bez zbędnego klikania.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["*://*/*"],
  "host_permissions": ["*://web.usos.pwr.edu.pl/*", "https://*.tile.openstreetmap.org/*"],
  "content_scripts": [
    {
      "matches": ["*://web.usos.pwr.edu.pl/*"],
      "css": ["fonts/fonts.css", "core/ui/design-system.css", "usos/usos.css", "vendor/leaflet/leaflet.css"],
      "js": [
        "core/state-bridge.js",
        "core/detect.js",
        "core/sanitize-html.js",
        "vendor/leaflet/leaflet.js",
        "usos/planner-store.js",
        "usos/adapters.js",
        "usos/scraping.js",
        "usos/generator.js",
        "usos/app.js",
        "usos/inject.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/generalsans/*.woff2", "fonts/inter/*.woff2", "vendor/leaflet/images/*.png"],
      "matches": ["*://web.usos.pwr.edu.pl/*", "*://*/*"]
    }
  ]
}
