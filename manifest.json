{
  "manifest_version": 3,
  "name": "USOS++",
  "version": "0.1.0",
  "description": "Redesign USOSweb i szybkie funkcje dla studentów — bez USOS API.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "alarms", "notifications", "activeTab"],
  "optional_host_permissions": ["*://*/*"],
  "host_permissions": ["*://web.usos.pwr.edu.pl/*"],
  "content_scripts": [
    {
      "matches": ["*://web.usos.pwr.edu.pl/*"],
      "css": ["fonts/fonts.css", "content/redesign.css"],
      "js": [
        "content/state-bridge.js",
        "content/planner-store.js",
        "content/adapters.js",
        "content/scraping.js",
        "content/app.js",
        "content/inject.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/generalsans/*.woff2", "fonts/inter/*.woff2"],
      "matches": ["*://web.usos.pwr.edu.pl/*", "*://*/*"]
    }
  ]
}
